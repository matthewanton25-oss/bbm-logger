{
  "expo": {
    "name": "YachtOps",
    "slug": "yachtops",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.yachtops.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1F3A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.yachtops.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#1EB6E6"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "YachtOps uses your photos to add yacht and profile pictures."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image"
    ],
    "scheme": "yachtops",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
